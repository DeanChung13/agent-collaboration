#!/usr/bin/env bash
set -euo pipefail

AGENT="${1:-}"
shift || true
MESSAGE="$*"

if [ -z "$AGENT" ] || [ -z "$MESSAGE" ]; then
  echo "Usage: agent-send <agent> <message>" >&2
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
REGISTRY="$ROOT/.agents/registry"

if [ ! -f "$REGISTRY" ]; then
  echo "Agent registry not found: $REGISTRY" >&2
  echo "Register the running sessions first with agent-register." >&2
  exit 1
fi

LOOKUP="$(awk -v agent="$AGENT" '
  { sub(/\r$/, "") }
  /^[[:space:]]*($|#)/ { next }
  tolower($1) == tolower(agent) {
    printf "%s %s %s %s\n", $2, ($3 == "" ? "-" : $3), ($4 == "" ? "-" : $4), ($6 == "" ? "-" : $6)
    exit
  }
' "$REGISTRY")"
read -r PANE EXPECTED_PANE_PID EXPECTED_AGENT_PID EXPECTED_COMMAND <<< "$LOOKUP"

if [ -z "$LOOKUP" ] || [ -z "$PANE" ]; then
  echo "Agent not registered: $AGENT" >&2
  exit 1
fi

if [ -z "$EXPECTED_PANE_PID" ] || [ "$EXPECTED_PANE_PID" = '-' ] || \
   [ -z "$EXPECTED_AGENT_PID" ] || [ "$EXPECTED_AGENT_PID" = '-' ]; then
  echo "Stale or legacy registry entry for $AGENT (missing lifecycle PID in $REGISTRY)." >&2
  echo "The columns are: agent-name pane-id pane-pid agent-pid tmux-session pane-command." >&2
  echo "You cannot fix this from the other agent's pane, so do one of these instead:" >&2
  echo "  - run 'agent-collab repair $AGENT' from here to rebuild the entry from live tmux state, or" >&2
  echo "  - ask that agent to re-run 'agent-collab join $AGENT' in its own pane." >&2
  exit 1
fi

if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fqx -- "$PANE"; then
  echo "tmux pane no longer exists: $PANE" >&2
  echo "The $AGENT session is gone. Do not guess a replacement pane; restart and re-register it." >&2
  exit 1
fi

CURRENT_PID="$(tmux display-message -p -t "$PANE" '#{pane_pid}' 2>/dev/null || true)"
if [ "$CURRENT_PID" != "$EXPECTED_PANE_PID" ]; then
  echo "Stale registry entry: pane $PANE belongs to a different process (current pid: ${CURRENT_PID:-none}, expected: $EXPECTED_PANE_PID)." >&2
  echo "Re-run agent-register in the $AGENT session." >&2
  exit 1
fi

if ! kill -0 "$EXPECTED_AGENT_PID" 2>/dev/null; then
  echo "Agent process no longer exists: $AGENT (pid: $EXPECTED_AGENT_PID)." >&2
  exit 1
fi

if [ -n "${TMUX_PANE:-}" ] && [ "$PANE" = "$TMUX_PANE" ]; then
  echo "Refusing to send to yourself: $AGENT is this pane ($PANE)" >&2
  exit 1
fi

CURRENT_COMMAND="$(tmux display-message -p -t "$PANE" '#{pane_current_command}' 2>/dev/null || true)"
if [ -n "$EXPECTED_COMMAND" ] && [ "$EXPECTED_COMMAND" != '-' ] && \
   [ -n "$CURRENT_COMMAND" ] && [ "$CURRENT_COMMAND" != "$EXPECTED_COMMAND" ]; then
  echo "Warning: pane $PANE is running '$CURRENT_COMMAND' but $AGENT was registered as '$EXPECTED_COMMAND'." >&2
  echo "Delivering anyway; verify the reply comes from $AGENT before trusting it." >&2
fi

PANE_IN_MODE="$(tmux display-message -p -t "$PANE" '#{pane_in_mode}' 2>/dev/null || true)"
if [ "$PANE_IN_MODE" != "0" ] && [ -n "$PANE_IN_MODE" ]; then
  tmux send-keys -t "$PANE" -X cancel
fi

BUF="agent-send-$$-${RANDOM}"
tmux set-buffer -b "$BUF" -- "$MESSAGE"
tmux paste-buffer -p -d -b "$BUF" -t "$PANE"
sleep 0.4
tmux send-keys -t "$PANE" Enter

echo "Sent to $AGENT ($PANE)"
