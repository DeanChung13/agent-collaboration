#!/usr/bin/env bash
set -euo pipefail

# Portable symlink resolution
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd -P)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd -P)"

usage() {
  cat <<'EOF'
Usage: agent-collab <command> [arguments...]

Commands:
  add <name>              Open a new tmux pane and start a collaborating AI
  run <name>              Register this pane and launch a supported AI CLI
  join [--force] <name>   Register the current pane without launching a CLI
  list                    List all registered agents in this repository
  repair <name>           Rebuild a legacy or incomplete entry from live tmux state
  send <agent> <message>  Send a prompt to another registered agent

Options:
  -h, --help              Show this help message
      --force             (join only) Take over a name that is still live
EOF
}

# Print the pane id of a live registry entry for the given agent name, if any.
# Liveness matches the `list` command: the agent process must still exist and the
# pane must still be the one that was registered.
live_pane() {
  registry="$1"
  name="$2"
  [ -f "$registry" ] || return 0
  while read -r entry_name entry_pane entry_pane_pid entry_agent_pid _; do
    case "$entry_name" in ''|'#'*) continue ;; esac
    [ -n "$entry_agent_pid" ] || continue
    [ "$(printf '%s' "$entry_name" | tr '[:upper:]' '[:lower:]')" \
      = "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" ] || continue
    kill -0 "$entry_agent_pid" 2>/dev/null || continue
    current_pane_pid="$(tmux display-message -p -t "$entry_pane" '#{pane_pid}' 2>/dev/null || true)"
    [ "$current_pane_pid" = "$entry_pane_pid" ] || continue
    printf '%s\n' "$entry_pane"
    return 0
  done < "$registry"
}

# Describe a pane as "session:%id" for human-readable errors, falling back to the
# bare pane id when tmux cannot resolve a session name.
pane_label() {
  pane="$1"
  session="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)"
  case "$session" in
    ''|*[[:space:]]*) printf '%s\n' "$pane" ;;
    *) printf '%s:%s\n' "$session" "$pane" ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  add)
    shift
    if [ "$#" -ne 1 ]; then
      echo "Usage: agent-collab add <agent-name>" >&2
      exit 1
    fi
    agent_name="$1"
    case "$agent_name" in
      agy|claude|codex|gemini) ;;
      *)
        echo "Unsupported agent '$agent_name'. Supported agents: agy, claude, codex, gemini." >&2
        exit 1
        ;;
    esac
    if [ -z "${TMUX_PANE:-}" ]; then
      echo 'Error: Cannot add a collaboration pane outside tmux.' >&2
      exit 1
    fi
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REGISTRY="$ROOT/.agents/registry"
    existing_pane="$(live_pane "$REGISTRY" "$agent_name")"
    if [ -n "$existing_pane" ]; then
      echo "Error: $agent_name is already running in $(pane_label "$existing_pane"); not starting a second one." >&2
      echo "Use 'agent-collab send $agent_name <message>' to reach it." >&2
      exit 1
    fi
    NEW_PANE="$(tmux split-window -d -P -F '#{pane_id}' -c "$ROOT" \
      "$SCRIPT_DIR/agent-collab" run "$agent_name")"
    registered=0
    for _ in {1..50}; do
      if [ -f "$REGISTRY" ] && awk -v name="$agent_name" -v pane="$NEW_PANE" '
        tolower($1) == tolower(name) && $2 == pane { found = 1 }
        END { exit(found ? 0 : 1) }
      ' "$REGISTRY"; then
        registered=1
        break
      fi
      sleep 0.1
    done
    if [ "$registered" -ne 1 ]; then
      echo "Error: $agent_name did not register in $NEW_PANE." >&2
      exit 1
    fi
    echo "Added $agent_name in $NEW_PANE"
    ;;
  run)
    shift
    if [ "$#" -ne 1 ]; then
      echo "Usage: agent-collab run <agent-name>" >&2
      exit 1
    fi
    agent_name="$1"
    case "$agent_name" in
      agy|claude|codex|gemini)
        if ! command -v "$agent_name" >/dev/null 2>&1; then
          echo "Error: Cannot launch $agent_name because '$agent_name' is not available in PATH." >&2
          exit 1
        fi
        ;;
      *)
        echo "Unsupported agent '$agent_name'. Supported agents: agy, claude, codex, gemini." >&2
        exit 1
        ;;
    esac
    "$SCRIPT_DIR/agent-register" "$agent_name" "$$"
    exec "$agent_name"
    ;;
  join)
    shift
    force=0
    join_name=""
    join_extra=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -h|--help)
          echo "Usage: agent-collab join [--force] <agent-name>"
          echo
          echo "Register the current tmux pane under <agent-name> in this repository."
          echo "Refuses a name that another live pane already holds; --force takes it over."
          exit 0
          ;;
        --force)
          force=1
          shift
          ;;
        --)
          shift
          ;;
        -*)
          echo "Unknown option for join: $1" >&2
          echo "Usage: agent-collab join [--force] <agent-name>" >&2
          exit 1
          ;;
        *)
          if [ -n "$join_name" ]; then
            join_extra=1
          else
            join_name="$1"
          fi
          shift
          ;;
      esac
    done
    if [ -z "$join_name" ] || [ "$join_extra" -ne 0 ]; then
      echo "Usage: agent-collab join [--force] <agent-name>" >&2
      exit 1
    fi
    if [ "$force" -ne 1 ]; then
      ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
      REGISTRY="$ROOT/.agents/registry"
      existing_pane="$(live_pane "$REGISTRY" "$join_name")"
      if [ -n "$existing_pane" ] && [ "$existing_pane" != "${TMUX_PANE:-}" ]; then
        echo "Error: $join_name is already registered to a live pane ($(pane_label "$existing_pane"))." >&2
        echo "The registry is keyed by name across the whole repository, so registering" >&2
        echo "again would silently redirect that agent's messages to this pane." >&2
        echo "Pick a distinct name (e.g. ${join_name}-2), reach it with" >&2
        echo "'agent-collab send $join_name <message>', or re-run with --force to take over." >&2
        exit 1
      fi
    fi
    exec "$SCRIPT_DIR/agent-register" "$join_name"
    ;;
  send)
    shift
    if [ "$#" -lt 2 ]; then
      echo "Usage: agent-collab send <agent-name> <message>" >&2
      exit 1
    fi
    exec "$SCRIPT_DIR/agent-send" "$@"
    ;;
  list)
    shift
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REGISTRY="$ROOT/.agents/registry"
    if [ ! -f "$REGISTRY" ]; then
      echo "No agents registered yet."
      exit 0
    fi
    TMP="$(mktemp "${REGISTRY}.tmp.XXXXXX" 2>/dev/null || mktemp "$ROOT/.agents/registry.tmp.XXXXXX")"
    trap 'rm -f "$TMP"' EXIT
    printf '# agent-name    tmux-pane-id    pane-pid        agent-pid       tmux-session    pane-command\n' > "$TMP"
    ENTRIES=""
    while read -r name pane pane_pid agent_pid session command _; do
      case "$name" in ''|'#'*) continue ;; esac
      [ -n "$agent_pid" ] || continue
      if ! kill -0 "$agent_pid" 2>/dev/null; then
        continue
      fi
      current_pane_pid="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
      if [ "$current_pane_pid" != "$pane_pid" ]; then
        continue
      fi
      current_session="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)"
      case "$current_session" in
        ''|*[[:space:]]*) current_session="${session:--}" ;;
      esac
      case "$current_session" in
        ''|*[[:space:]]*) current_session='-' ;;
      esac
      current_command="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
      case "$current_command" in
        ''|*[[:space:]]*) current_command="${command:--}" ;;
      esac
      case "$current_command" in
        ''|*[[:space:]]*) current_command='-' ;;
      esac
      printf '%-15s %-15s %-15s %-15s %-15s %s\n' \
        "$name" "$pane" "$pane_pid" "$agent_pid" "$current_session" "$current_command" >> "$TMP"
      ENTRIES="${ENTRIES}  $(printf '%-15s %-15s %-10s (pid: %s, cmd: %s)' \
        "$name" "$current_session" "$pane" "$agent_pid" "$current_command")
"
    done < "$REGISTRY"
    mv -f "$TMP" "$REGISTRY"
    trap - EXIT
    if [ -z "$ENTRIES" ]; then
      echo "No agents registered yet."
      exit 0
    fi
    echo "Registered agents:"
    printf '%s' "$ENTRIES"
    ;;
  repair)
    shift
    if [ "$#" -ne 1 ]; then
      echo "Usage: agent-collab repair <agent-name>" >&2
      exit 1
    fi
    repair_name="$1"
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REGISTRY="$ROOT/.agents/registry"
    if [ ! -f "$REGISTRY" ]; then
      echo "Agent registry not found: $REGISTRY" >&2
      exit 1
    fi
    repair_pane="$(awk -v agent="$repair_name" '
      { sub(/\r$/, "") }
      /^[[:space:]]*($|#)/ { next }
      tolower($1) == tolower(agent) { print $2; exit }
    ' "$REGISTRY")"
    if [ -z "$repair_pane" ]; then
      echo "Agent not registered: $repair_name" >&2
      echo "Nothing to repair. Register it from its own pane with 'agent-collab join $repair_name'." >&2
      exit 1
    fi
    if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fqx -- "$repair_pane"; then
      echo "tmux pane no longer exists: $repair_pane" >&2
      echo "The $repair_name session is gone; repair cannot guess a replacement pane." >&2
      echo "Restart that agent and register it from its own pane." >&2
      exit 1
    fi
    repair_pane_pid="$(tmux display-message -p -t "$repair_pane" '#{pane_pid}' 2>/dev/null || true)"
    if [ -z "$repair_pane_pid" ]; then
      echo "Error: Failed to obtain pane_pid for pane $repair_pane from tmux." >&2
      exit 1
    fi
    repair_session="$(tmux display-message -p -t "$repair_pane" '#{session_name}' 2>/dev/null || true)"
    case "$repair_session" in
      ''|*[[:space:]]*) repair_session='-' ;;
    esac
    repair_command="$(tmux display-message -p -t "$repair_pane" '#{pane_current_command}' 2>/dev/null || true)"
    case "$repair_command" in
      ''|*[[:space:]]*) repair_command='-' ;;
    esac
    TMP="$(mktemp "${REGISTRY}.tmp.XXXXXX" 2>/dev/null || mktemp "$ROOT/.agents/registry.tmp.XXXXXX")"
    trap 'rm -f "$TMP"' EXIT
    awk -v name="$repair_name" -v pane="$repair_pane" -v pane_pid="$repair_pane_pid" \
      -v session="$repair_session" -v command="$repair_command" '
      BEGIN { found = 0 }
      { sub(/\r$/, "") }
      /^[[:space:]]*($|#)/ { print; next }
      tolower($1) == tolower(name) {
        if (!found) {
          printf "%-15s %-15s %-15s %-15s %-15s %s\n", name, pane, pane_pid, pane_pid, session, command
          found = 1
        }
        next
      }
      { print }
    ' "$REGISTRY" > "$TMP"
    mv -f "$TMP" "$REGISTRY"
    trap - EXIT
    echo "Repaired $repair_name -> $repair_pane in session $repair_session (pane pid: $repair_pane_pid, cmd: $repair_command)"
    echo "Note: agent-pid was rebound to the pane's root process ($repair_pane_pid)."
    echo "If that agent was launched by 'agent-collab run', re-register from its own pane for an exact lifecycle binding."
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
